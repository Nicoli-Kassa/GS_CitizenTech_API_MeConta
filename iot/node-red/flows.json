    {
        "id": "tratar-estado",
        "type": "function",
        "z": "aba-ponte-porta-retrato",
        "name": "monta a mensagem da caixinha",
        "func": "// Saídas: 1 = MQTT (pergunta, retida); 2 = painel \"na telinha\"; 3 = painel \"API\".\nif (msg.statusCode !== 200) {\n    const motivo = typeof msg.statusCode === 'number' ? 'HTTP ' + msg.statusCode : 'sem resposta';\n    node.status({ fill: 'red', shape: 'ring', text: 'API: ' + motivo });\n    return [null, null, { payload: '🔴 Fora do ar (' + motivo + ')' }];\n}\n\nconst e = msg.payload;\n// Para a caixinha vão só o apelido, o primeiro nome de quem perguntou e o texto (o broker é público).\nconst saida = {\n    temPerguntaNova: !!e.temPerguntaNova,\n    apelido: e.apelido,\n    perguntasEsperando: e.perguntasEsperando || 0\n};\nif (e.pergunta) {\n    saida.envioId = e.pergunta.envioId;\n    saida.quemPerguntou = e.pergunta.quemPerguntou;\n    saida.pergunta = e.pergunta.texto;\n}\n\nconst naTela = e.pergunta\n    ? '🟠 ' + e.pergunta.quemPerguntou + ' perguntou: ' + e.pergunta.texto +\n      (e.perguntasEsperando > 1 ? ' (+' + (e.perguntasEsperando - 1) + ' na fila)' : '')\n    : '⚫ Nada novo (moldura apagada)';\nnode.status({\n    fill: e.temPerguntaNova ? 'yellow' : 'green', shape: 'dot',\n    text: e.temPerguntaNova ? 'envio ' + saida.envioId + ' (' + saida.perguntasEsperando + ' esperando)' : 'sem pergunta'\n});\n\nconst texto = JSON.stringify(saida);\nconst mudou = texto !== flow.get('ultimoEstadoPublicado');\nif (mudou) flow.set('ultimoEstadoPublicado', texto);\nreturn [mudou ? { payload: saida } : null, { payload: naTela }, { payload: '🟢 No ar' }];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1250,
        "y": 340,
        "wires": [
            [
                "publicar-pergunta"
            ],
            [
                "ui-na-tela"
            ],
            [
                "ui-api"
            ]
        ]
    },
