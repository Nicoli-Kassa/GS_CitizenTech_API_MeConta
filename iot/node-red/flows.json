    {
        "id": "tratar-quero-contar",
        "type": "function",
        "z": "aba-ponte-porta-retrato",
        "name": "registra o aviso",
        "func": "// Saídas: 1 = painel \"último aviso\"; 2 = atualizar caixinha e avisos.\nif (msg.statusCode === 201 || msg.statusCode === 200) {\n    const a = msg.payload;\n    const hora = new Date(a.criadoEm).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit' });\n    node.status({ fill: 'green', shape: 'dot', text: 'aviso ' + a.id + (msg.statusCode === 201 ? ' criado' : ' já existia') });\n    return [{ payload: hora + ' · ' + a.apelido + ' quer contar' + (a.pergunta ? ': ' + a.pergunta : ' uma história') },\n            { payload: 'atualizar' }];\n}\nnode.status({ fill: 'red', shape: 'ring', text: 'recusado: ' + msg.statusCode });\nnode.warn({ aviso: 'quero-contar recusado pela API', status: msg.statusCode, resposta: msg.payload });\nreturn [{ payload: 'Aviso recusado pela API (' + msg.statusCode + ')' }, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1220,
        "y": 640,
        "wires": [
